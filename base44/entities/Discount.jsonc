{
  "name": "Discount",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Bu kayd\u0131n ait oldu\u011fu restoran"
    },
    "name": {
      "type": "string"
    },
    "code": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "percentage",
        "fixed"
      ],
      "default": "percentage"
    },
    "value": {
      "type": "number"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "code",
    "type",
    "value"
  ]
}