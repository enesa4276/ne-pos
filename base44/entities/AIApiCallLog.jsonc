{
  "name": "AIApiCallLog",
  "type": "object",
  "description": "AI API \u00e7a\u011fr\u0131 loglar\u0131 \u2014 debug i\u00e7in (request/response s\u00fcresi, ba\u015far\u0131 durumu, hata mesajlar\u0131)",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "ai_feature": {
      "type": "string"
    },
    "primary_config_id": {
      "type": "string",
      "description": "Birincil olarak denenen konfig"
    },
    "used_config_id": {
      "type": "string",
      "description": "Sonunda ba\u015far\u0131l\u0131 olan konfig (fallback olabilir)"
    },
    "ai_provider": {
      "type": "string"
    },
    "model_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "success",
        "fallback_success",
        "failed"
      ],
      "default": "success"
    },
    "duration_ms": {
      "type": "number",
      "default": 0
    },
    "prompt_tokens": {
      "type": "number",
      "default": 0
    },
    "completion_tokens": {
      "type": "number",
      "default": 0
    },
    "total_tokens": {
      "type": "number",
      "default": 0
    },
    "error_message": {
      "type": "string"
    },
    "fallback_used": {
      "type": "boolean",
      "default": false
    },
    "is_test": {
      "type": "boolean",
      "default": false
    },
    "user_email": {
      "type": "string"
    }
  },
  "required": [
    "ai_feature",
    "status"
  ]
}