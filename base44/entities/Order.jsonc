{
  "name": "Order",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Bu kayd\u0131n ait oldu\u011fu restoran"
    },
    "order_type": {
      "type": "string",
      "enum": [
        "dine_in",
        "takeaway",
        "delivery",
        "phone"
      ],
      "description": "Masada or Gel-Al or Delivery or Phone"
    },
    "table_id": {
      "type": "string",
      "description": "RestaurantTable ID, null for takeaway"
    },
    "table_name": {
      "type": "string",
      "description": "Table name for display"
    },
    "items": {
      "type": "array",
      "description": "List of order items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "base_price": {
            "type": "number"
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "cancelled",
        "pending",
        "accepted",
        "preparing",
        "ready_for_delivery_pickup",
        "out_for_delivery",
        "fulfilled",
        "completed"
      ],
      "default": "open"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card"
      ]
    },
    "total": {
      "type": "number"
    },
    "sent_to_kitchen": {
      "type": "boolean",
      "default": false
    },
    "order_source": {
      "type": "string",
      "enum": [
        "pos_dine_in",
        "pos_takeaway",
        "wix",
        "takeaway_com",
        "uber_eats",
        "menupro",
        "ai_phone"
      ],
      "default": "pos_dine_in"
    },
    "wix_order_id": {
      "type": "string"
    },
    "payment_status_wix": {
      "type": "string",
      "enum": [
        "PAID",
        "UNPAID",
        "PARTIALLY_PAID",
        "FULLY_REFUNDED",
        "PARTIALLY_REFUNDED",
        ""
      ]
    },
    "payment_method_wix": {
      "type": "string"
    },
    "amount_due_wix": {
      "type": "number"
    },
    "fulfillment_status": {
      "type": "string"
    },
    "delivery_address": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "customer_phone": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "wix_site_id": {
      "type": "string"
    },
    "external_order_id": {
      "type": "string"
    },
    "external_payment_status": {
      "type": "string"
    },
    "external_payment_method": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "order_type",
    "status"
  ]
}