{
  "name": "Order",
  "type": "object",
  "properties": {
    "order_type": {
      "type": "string",
      "enum": [
        "dine_in",
        "takeaway"
      ],
      "description": "Masada or Gel-Al"
    },
    "table_id": {
      "type": "string",
      "description": "RestaurantTable ID, null for takeaway"
    },
    "table_name": {
      "type": "string",
      "description": "Table name for display"
    },
    "items": {
      "type": "array",
      "description": "List of order items",
      "items": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "base_price": {
            "type": "number"
          },
          "extras": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "price": {
                  "type": "number"
                }
              }
            }
          },
          "quantity": {
            "type": "number"
          },
          "subtotal": {
            "type": "number"
          }
        }
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "paid",
        "cancelled",
        "pending",
        "accepted",
        "preparing",
        "ready_for_delivery_pickup",
        "out_for_delivery",
        "fulfilled"
      ],
      "default": "open",
      "description": "Current status of the order"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "card"
      ],
      "description": "Payment method used for POS orders"
    },
    "total": {
      "type": "number",
      "description": "Grand total"
    },
    "sent_to_kitchen": {
      "type": "boolean",
      "default": false
    },
    "order_source": {
      "type": "string",
      "enum": [
        "pos_dine_in",
        "pos_takeaway",
        "wix",
        "takeaway_com",
        "uber_eats"
      ],
      "default": "pos_dine_in",
      "description": "Source of the order"
    },
    "wix_order_id": {
      "type": "string",
      "description": "Wix unique order ID"
    },
    "payment_status_wix": {
      "type": "string",
      "enum": [
        "PAID",
        "UNPAID",
        "PARTIALLY_PAID",
        "FULLY_REFUNDED",
        "PARTIALLY_REFUNDED"
      ],
      "description": "Payment status from Wix"
    },
    "payment_method_wix": {
      "type": "string",
      "description": "Payment method from Wix (e.g. CreditCard, PayPal)"
    },
    "amount_due_wix": {
      "type": "number",
      "description": "Amount due from Wix order"
    },
    "delivery_address": {
      "type": "string",
      "description": "Full delivery address for online orders"
    },
    "customer_name": {
      "type": "string",
      "description": "Customer name from online order"
    },
    "customer_phone": {
      "type": "string",
      "description": "Customer phone from online order"
    },
    "customer_email": {
      "type": "string",
      "description": "Customer email from online order"
    },
    "wix_site_id": {
      "type": "string",
      "description": "Wix site ID this order belongs to"
    },
    "external_order_id": {
      "type": "string",
      "description": "Unique order ID from external platform (Takeaway, Uber Eats)"
    },
    "external_payment_status": {
      "type": "string",
      "description": "Payment status from external platform"
    },
    "external_payment_method": {
      "type": "string",
      "description": "Payment method from external platform"
    }
  },
  "required": [
    "order_type",
    "status"
  ]
}