{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Category name"
    },
    "color": {
      "type": "string",
      "description": "Tailwind color class for the category"
    },
    "icon": {
      "type": "string",
      "description": "Icon name from lucide"
    },
    "sort_order": {
      "type": "number",
      "default": 0,
      "description": "Display order"
    }
  },
  "required": [
    "name"
  ]
}