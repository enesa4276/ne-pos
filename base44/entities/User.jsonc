{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "tenant_id": {
      "type": "string",
      "description": "Kullan\u0131c\u0131n\u0131n ait oldu\u011fu tenant"
    },
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Sistem admin (t\u00fcm tenantlara eri\u015fir)"
    },
    "selected_tenant_id": {
      "type": "string",
      "description": "Super admin hangi tenantta \u00e7al\u0131\u015f\u0131yor"
    },
    "permissions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "company_name": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email_receipt": {
      "type": "string"
    },
    "receipt_footer": {
      "type": "string"
    },
    "receipt_logo_url": {
      "type": "string"
    },
    "receipt_font": {
      "type": "string",
      "enum": [
        "default",
        "monospace",
        "serif"
      ],
      "default": "default"
    },
    "receipt_paper_size": {
      "type": "string",
      "enum": [
        "58mm",
        "80mm"
      ],
      "default": "80mm"
    },
    "receipt_font_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium"
    },
    "max_tablets": {
      "type": "number",
      "default": 3,
      "description": "Bu hesap i\u00e7in izin verilen tablet say\u0131s\u0131"
    }
  }
}