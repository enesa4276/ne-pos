{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "tenant_id": {
      "type": "string"
    },
    "is_super_admin": {
      "type": "boolean",
      "default": false
    },
    "selected_tenant_id": {
      "type": "string"
    },
    "permissions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "company_name": {
      "type": "string"
    },
    "vat_number": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email_receipt": {
      "type": "string"
    },
    "receipt_footer": {
      "type": "string"
    },
    "receipt_footer_2": {
      "type": "string",
      "description": "\u0130kinci sat\u0131r footer (\u00f6rn. instagram/website)"
    },
    "receipt_header_extra": {
      "type": "string",
      "description": "Ba\u015fl\u0131k alt\u0131 ekstra not"
    },
    "receipt_logo_url": {
      "type": "string"
    },
    "receipt_font": {
      "type": "string",
      "enum": [
        "default",
        "monospace",
        "serif"
      ],
      "default": "default"
    },
    "receipt_paper_size": {
      "type": "string",
      "enum": [
        "58mm",
        "80mm"
      ],
      "default": "80mm"
    },
    "receipt_font_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large",
        "xlarge"
      ],
      "default": "medium"
    },
    "receipt_font_weight": {
      "type": "string",
      "enum": [
        "normal",
        "bold"
      ],
      "default": "normal"
    },
    "receipt_align": {
      "type": "string",
      "enum": [
        "left",
        "center"
      ],
      "default": "left"
    },
    "receipt_separator": {
      "type": "string",
      "enum": [
        "dashed",
        "solid",
        "double",
        "none"
      ],
      "default": "dashed",
      "description": "\u00dcr\u00fcn ayra\u00e7 stili"
    },
    "receipt_show_logo": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_company": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_address": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_vat": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_table": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_datetime": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_order_number": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_extras": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_subtotal": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_tax": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_staff": {
      "type": "boolean",
      "default": true
    },
    "receipt_show_qr": {
      "type": "boolean",
      "default": false
    },
    "receipt_tax_rate": {
      "type": "number",
      "default": 21
    },
    "max_tablets": {
      "type": "number",
      "default": 3
    }
  }
}