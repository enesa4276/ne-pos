{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "user"
      ],
      "default": "user"
    },
    "tenant_id": {
      "type": "string",
      "description": "Kullan\u0131c\u0131n\u0131n ait oldu\u011fu tenant"
    },
    "is_super_admin": {
      "type": "boolean",
      "default": false,
      "description": "Sistem admin (t\u00fcm tenant'lara eri\u015fir)"
    },
    "selected_tenant_id": {
      "type": "string",
      "description": "Super admin hangi tenant'ta \u00e7al\u0131\u015f\u0131yor"
    },
    "permissions": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      },
      "description": "['orders.create', 'products.edit']"
    },
    "company_name": {
      "type": "string",
      "description": "Company/Restaurant Name for receipts"
    },
    "vat_number": {
      "type": "string",
      "description": "VAT Number for receipts"
    },
    "address": {
      "type": "string",
      "description": "Address for receipts"
    },
    "phone": {
      "type": "string",
      "description": "Phone number for receipts"
    },
    "email_receipt": {
      "type": "string",
      "description": "Email to display on receipts"
    },
    "receipt_footer": {
      "type": "string",
      "description": "Custom footer message for receipts"
    },
    "receipt_logo_url": {
      "type": "string",
      "description": "Logo image URL to display on receipts"
    },
    "receipt_font": {
      "type": "string",
      "enum": [
        "default",
        "monospace",
        "serif"
      ],
      "default": "default"
    },
    "receipt_paper_size": {
      "type": "string",
      "enum": [
        "58mm",
        "80mm"
      ],
      "default": "80mm"
    },
    "receipt_font_size": {
      "type": "string",
      "enum": [
        "small",
        "medium",
        "large"
      ],
      "default": "medium"
    },
    "wix_webhook_secret": {
      "type": "string"
    },
    "wix_site_id": {
      "type": "string"
    },
    "takeaway_webhook_secret": {
      "type": "string"
    },
    "takeaway_store_id": {
      "type": "string"
    },
    "uber_eats_webhook_secret": {
      "type": "string"
    },
    "uber_eats_store_id": {
      "type": "string"
    },
    "menupro_restaurant_id": {
      "type": "string",
      "description": "Menupro restaurant/store ID"
    }
  },
  "required": [
    "tenant_id",
    "selected_tenant_id",
    "company_name",
    "vat_number",
    "address",
    "phone",
    "email_receipt",
    "receipt_footer",
    "receipt_logo_url",
    "wix_webhook_secret",
    "wix_site_id",
    "takeaway_webhook_secret",
    "takeaway_store_id",
    "uber_eats_webhook_secret",
    "uber_eats_store_id",
    "menupro_restaurant_id"
  ]
}