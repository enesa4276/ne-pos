{
  "name": "Product",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Bu kayd\u0131n ait oldu\u011fu restoran"
    },
    "name": {
      "type": "string",
      "description": "Product name"
    },
    "category_id": {
      "type": "string",
      "description": "Category ID"
    },
    "base_price": {
      "type": "number",
      "description": "Base price in EUR"
    },
    "image_url": {
      "type": "string",
      "description": "Product image URL"
    },
    "extra_group_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of ExtraGroup IDs attached to this product"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "\u00dcr\u00fcn sat\u0131\u015fa a\u00e7\u0131k m\u0131"
    },
    "out_of_stock_reason": {
      "type": "string",
      "description": "\u00dcr\u00fcn pasifse t\u00fckenme/durdurma nedeni"
    }
  },
  "required": [
    "name",
    "base_price"
  ]
}