{
  "name": "AIApiConfig",
  "type": "object",
  "description": "AI API konfig\u00fcrasyonlar\u0131 ve \u00f6zellik e\u015fle\u015ftirmeleri",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Bu konfig\u00fcrasyonun ait oldu\u011fu restoran (tenant). 'global' = t\u00fcm tenantlar i\u00e7in varsay\u0131lan"
    },
    "ai_feature": {
      "type": "string",
      "enum": [
        "ai_phone_order",
        "smart_menu_suggestion",
        "eod_summary",
        "transcription",
        "menu_photo_import"
      ],
      "description": "Hangi AI \u00f6zelli\u011fi i\u00e7in bu konfig\u00fcrasyon yap\u0131ld\u0131"
    },
    "ai_provider": {
      "type": "string",
      "enum": [
        "OpenAI",
        "OpenRouter",
        "Groq",
        "Deepgram",
        "Anthropic"
      ],
      "description": "Kullan\u0131lacak AI sa\u011flay\u0131c\u0131s\u0131"
    },
    "model_name": {
      "type": "string",
      "description": "Sa\u011flay\u0131c\u0131n\u0131n hangi modeli kullan\u0131lacak"
    },
    "secret_name": {
      "type": "string",
      "description": "Base44 Dashboard'da tan\u0131mlanan API anahtar\u0131n\u0131n s\u0131r ad\u0131"
    },
    "temperature": {
      "type": "number",
      "default": 0.7
    },
    "max_tokens": {
      "type": "number",
      "default": 500
    },
    "monthly_budget_eur": {
      "type": "number",
      "default": 0,
      "description": "Bu konfig\u00fcrasyon i\u00e7in ayl\u0131k b\u00fct\u00e7e limiti (EUR)"
    },
    "monthly_usage_eur": {
      "type": "number",
      "default": 0,
      "description": "Bu ay t\u00fcketilen tahmini maliyet"
    },
    "fallback_config_id": {
      "type": "string",
      "description": "Birincil API ba\u015far\u0131s\u0131z olursa devreye girecek yedek AIApiConfig kayd\u0131n\u0131n id'si"
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "ai_feature",
    "ai_provider",
    "model_name",
    "secret_name"
  ]
}