{
  "name": "RestaurantTable",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string",
      "description": "Bu kayd\u0131n ait oldu\u011fu restoran"
    },
    "name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "empty",
        "occupied",
        "bill_requested"
      ],
      "default": "empty"
    },
    "qr_label": {
      "type": "string",
      "description": "QR bask\u0131 i\u00e7in ek etiket (\u00f6rn. Bah\u00e7e / Salon)"
    }
  },
  "required": [
